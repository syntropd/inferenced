[Unit]
Description=Heterogeneous AI Hardware Arbiter and Model Lifecycle Broker
Documentation=https://github.com/syntropd/inferenced
After=network.target local-fs.target
Requires=systemd-inferenced.socket

[Service]
Type=notify
ExecStart=/usr/bin/systemd-inferenced
Restart=on-failure
RestartSec=3s
WatchdogSec=30s
Slice=ai.slice

# Security & Sandboxing
User=inferenced
Group=inferenced
SupplementaryGroups=render video sentry
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Delegate=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
AmbientCapabilities=CAP_KILL CAP_SYS_PTRACE
CapabilityBoundingSet=CAP_KILL CAP_SYS_PTRACE

# Directories
RuntimeDirectory=systemd-inferenced
RuntimeDirectoryMode=0755
ConfigurationDirectory=systemd/inferenced.conf.d
StateDirectory=systemd-inferenced
LogsDirectory=systemd-inferenced

# Linux Device Permissions (DRM & Accel)
DeviceAllow=/dev/dri/renderD* rw
DeviceAllow=/dev/accel/* rw
DeviceAllow=/dev/hailo* rw
DeviceAllow=/dev/kfd rw
DeviceAllow=char-nvidia* rw

# cgroup v2 & systemd-oomd Protection
ManagedOOMPreference=avoid
OOMScoreAdjust=-900
OOMPolicy=stop

# Logging & systemd-journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=systemd-inferenced

# Crash Diagnostics & systemd-coredump
LimitCORE=infinity
Environment=RUST_BACKTRACE=1

# Encrypted Secrets & systemd-creds
# Decrypted secrets from LoadCredential/LoadCredentialEncrypted appear in $CREDENTIALS_DIRECTORY
# Example: LoadCredentialEncrypted=api_token:/etc/systemd/inferenced.conf.d/api_token.cred

[Install]
WantedBy=multi-user.target
Alias=inferenced.service
