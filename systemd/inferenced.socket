[Unit]
Description=inferenced Activation Sockets
Documentation=https://github.com/syntropd/inferenced

[Socket]
# File Descriptor 3: Native Varlink IPC socket
ListenStream=/run/syntrop/io.syntrop.Inference1
SocketMode=0666

# File Descriptor 4: Dedicated Sentry Emergency Triage socket
ListenStream=/run/syntrop/sentry.sock
SocketMode=0660
SocketGroup=sentry

# File Descriptor 5: Local OpenAI-compatible gateway socket
ListenStream=/run/syntrop/gateway.sock
SocketMode=0660
SocketGroup=syntrop

# File Descriptor 6: SCM_RIGHTS Zero-Copy Memfd Server socket
ListenStream=/run/syntrop/fd.sock
SocketMode=0660
SocketGroup=inferenced

# Ensure runtime directory /run/syntrop is provisioned
RuntimeDirectory=syntrop
RuntimeDirectoryMode=0755
DirectoryMode=0755

[Install]
WantedBy=sockets.target
Alias=systemd-inferenced.socket
